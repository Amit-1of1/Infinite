/*
 * Nextflow config file for Viral Capsid Pipeline
 */

params {
    input_fasta = "data/input.fasta"
    email = "your.email@example.com"
    outdir = "results"
    threads = 4

    // Alphafold/Colabfold specific parameters for Stage 3
    use_gpu = true
    colabfold_db = "/path/to/colabfold_db" // Path to local DBs on HPC
}

profiles {
    standard {
        process.executor = 'local'
    }

    hpc {
        process.executor = 'slurm'
        process.queue = 'compute'
        process.memory = '32 GB'
        process.time = '24h'

        withName: 'MULTIMER_ASSEMBLY' {
            queue = 'gpu'
            clusterOptions = '--gres=gpu:1'
            memory = '64 GB'
            time = '48h'
        }
    }

    docker {
        docker.enabled = true
        process.container = 'continuumio/miniconda3:latest'

        withName: 'MULTIMER_ASSEMBLY' {
            container = 'ghcr.io/sokrypton/colabfold:1.5.5'
            containerOptions = '--gpus all'
        }
    }
}
